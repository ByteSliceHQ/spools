{
  "name": "spools",
  "version": "0.1.0",
  "private": true,
  "description": "Open source CRM framework for coding agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteSliceHQ/spools.git"
  },
  "workspaces": [
    "apps/*",
    "examples",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint . --deny-warnings",
    "doctor": "react-doctor --verbose -y",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "playwright test --config apps/starter/e2e/playwright.config.ts",
    "test:e2e:npm": "bun run scripts/e2e-npm-package.ts",
    "verify": "turbo run build --filter=@swirls/spools && turbo run check-types && turbo run test && turbo run test:integration && bun run lint && bun run fmt:check",
    "dev": "turbo run dev --filter=@spools/starter --filter=@spools/docs",
    "demo": "turbo run dev --filter=@spools/starter",
    "docs": "turbo run dev --filter=@spools/docs",
    "examples": "bun run --filter @spools/examples all",
    "changeset": "changeset",
    "check:changeset": "bun run scripts/check-changeset.ts",
    "check:package": "bun run scripts/check-package.ts",
    "version-packages": "changeset version && bun install --lockfile-only && oxfmt packages/spools/CHANGELOG.md packages/create-spools/CHANGELOG.md",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "release": "bun run scripts/publish.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@effect/tsgo": "0.73.4",
    "@oxlint/plugins": "1.94.0",
    "@playwright/test": "1.65.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "^1.4.4",
    "effect": "4.1.5",
    "oxfmt": "0.80.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "react-doctor": "^0.9.23",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.4"
}
