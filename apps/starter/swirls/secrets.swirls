// Secret slots. Set values with `swirls secret set <block>::<VAR>=...` or in Swirls Cloud.

secret vendor_keys {
  label: "Vendor API keys"
  description: "LLM, email and web search providers used by CRM workflows and the assistant"
  vars: [OPENROUTER_API_KEY, RESEND_API_KEY, FIRECRAWL_API_KEY]
}

secret crm_app {
  label: "CRM app callback"
  description: "Public base URL of the deployed app and the bearer token for /api/swirls (SWIRLS_APP_TOKEN in the app env)"
  vars: [CRM_APP_URL, CRM_APP_TOKEN]
}

secret crm_mail {
  label: "CRM email addresses"
  description: "FROM_EMAIL must be on a domain verified in Resend. TEAM_EMAIL receives new-lead alerts."
  vars: [FROM_EMAIL, TEAM_EMAIL]
}
