# Copy to .env (or run `bun run init`, which does this and fills in secrets).
# Bun loads .env automatically. Never commit .env.
#
# A copy with none of this set still runs on your machine: its records are kept in a
# Postgres inside the server (.data/pglite) and it signs you straight in. Each block
# below turns on one real service. Which services are used is in src/spool.server.ts.

# ── Database (required in production) ───────────────────────────────────────
# Any Postgres. Locally, Supabase's is postgresql://postgres:postgres@127.0.0.1:54322/postgres
# (`bun run db:start`). On Supabase use the session-pooler or direct connection string.
# When unset, POSTGRES_URL is used (some hosting integrations set it).
DATABASE_URL=

# ── Signing in (required in production) ─────────────────────────────────────
# Clerk: https://dashboard.clerk.com -> API keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Or Better Auth (auth: betterAuth()): 32+ random characters. `openssl rand -hex 32`
# BETTER_AUTH_SECRET=
# Development sign-in only: who you are, and "1" to see the app signed out.
# DEV_AUTH_EMAIL=
# DEV_AUTH_SIGNED_OUT=

# Public URL of this app (unsubscribe links, sign-in links, Swirls callbacks)
APP_URL=http://localhost:3000
# 32+ random characters; signs unsubscribe links. `openssl rand -hex 32`
APP_SECRET=

# ── Swirls (optional: workflows, assistant) ─────────────────────────────────
# Without these, automations and actions that target swirls:* are skipped.
SWIRLS_PROJECT_ID=
# Leave the API key empty to use OIDC federation: the signed-in person's token from the
# auth provider (template "swirls", or SWIRLS_JWT_TEMPLATE) is exchanged for a short-lived
# Swirls token. Better Auth needs the API key. See docs/swirls.md.
SWIRLS_API_KEY=
# SWIRLS_JWT_TEMPLATE=swirls
# SWIRLS_API_URL=https://swirls.ai/api
# Bearer token Swirls uses to call /api/swirls/tools/*. 32+ random characters.
# Set the same value in Swirls: swirls secret set crm_app::CRM_APP_TOKEN=...
SWIRLS_APP_TOKEN=

# ── Email (optional) ────────────────────────────────────────────────────────
# Without these, emails are recorded on the timeline but not sent.
RESEND_API_KEY=
EMAIL_FROM="Acme <hello@example.com>"
# Signing secret of a Resend webhook for bounces and complaints -> /api/webhooks/email
RESEND_WEBHOOK_SECRET=

# Number of reverse proxies in front of the app that append to X-Forwarded-For
# (Fly or Railway: 1; Cloudflare in front of Fly: 2). 0 uses the socket address.
# Too high lets clients choose the address the app sees for them.
TRUST_PROXY=0

# Development only: extra hostnames the dev server accepts, comma-separated, when
# you share it through a tunnel (Datum, cloudflared, ngrok). A leading dot allows
# every subdomain, for example .datumproxy.net
# Without Clerk keys the dev server signs everyone in. Anyone with the tunnel's
# address then has the whole CRM, so share it only with a database of made-up data.
DEV_ALLOWED_HOSTS=

# ── Files (optional) ─────────────────────────────────────────────────────────
# With files: flashdrive(). Create a Read-write API key and a drive in the FlashDrive
# Console; use a different drive for development and production. See docs/files.md.
# FLASHDRIVE_API_KEY=
# FLASHDRIVE_DRIVE_ID=
# With files: drive({ blobs: s3Blobs() }). Any S3-compatible bucket.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Integrations (optional: teammates connect more mailboxes and services) ───
# The account a teammate signs in with needs none of this. To let them connect other
# accounts on the Integrations page, set up the vault that encrypts their tokens, plus
# APP_URL and APP_SECRET above. See docs/integrations.md.
# With vault: cipherstash()
# CS_WORKSPACE_CRN=
# CS_CLIENT_ID=
# CS_CLIENT_KEY=
# CS_CLIENT_ACCESS_KEY=
# With vault: aes(). `openssl rand -base64 32`. Keep replaced keys in VAULT_OLD_KEYS.
# VAULT_KEY=
# VAULT_OLD_KEYS=
# A provider is offered once its client id and secret are set. (Better Auth signs people
# in with these too.)
# Redirect URI: {APP_URL}/api/integrations/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Redirect URI: {APP_URL}/api/integrations/microsoft/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Limits connecting to your organisation. Default: common (any Microsoft account).
# MICROSOFT_TENANT_ID=

# ── Marketing (optional) ────────────────────────────────────────────────────
# Only for the networks your crm.config.json reaches directly. docs/marketing.md
# LinkedIn. Redirect URI: {APP_URL}/api/integrations/linkedin/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X. Redirect URI: {APP_URL}/api/integrations/x/callback
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# Facebook pages and Meta Ads: a system user's token from Meta Business settings.
# META_ACCESS_TOKEN=
# Google Ads uses GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET above.
# Redirect URI: {APP_URL}/api/integrations/google_ads/callback
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Mailbox (optional: teammates' own mail and calendar) ─────────────────────
# Nothing to set here to turn it on: teammates sign in with Google or Microsoft, and
# that connection carries the mail scopes. See docs/mailbox.md.
# How often mailboxes are read, in minutes (0 turns the built-in schedule off), and
# how far back the first read of an account goes.
# MAILBOX_SYNC_MINUTES=5
# MAILBOX_LOOKBACK_DAYS=30
# On a host with no long-lived process, set SERVERLESS=1. Cron jobs then call
# /api/cron/mail-sync and /api/cron/sequences (which sends the sequence emails that
# are due) with CRON_SECRET as a bearer token. 16+ random characters: `openssl rand -hex 32`
# SERVERLESS=1
# CRON_SECRET=

# Guides (optional). People are offered a short guide the first time they open
# each part of the CRM (docs/guides.md). Set to "off" to stop the offers for
# everyone; Help still lists the guides.
# CRM_GUIDES=off
