/// Timeline entries for any record: calls, meetings, notes, emails, form submissions, agent actions.
model Activity {
  id String @id @onCreate(uuid())
  createdAt DateTime @default(now()) @onCreate(now()) @map("created_at")
  objectKey String @map("object_key")
  recordId String @map("record_id")
  kind String
  summary String
  body String?
  actor String?
  /// The teammate who did it (the auth provider's user id), for per-person reports. `actor` is their name as shown.
  actorId String? @map("actor_id")
  /// When it happened, if that differs from when it was logged (a call entered the next day).
  occurredAt DateTime? @map("occurred_at")
  /// How it went: a call or meeting outcome, or sent / received / not_sent for an email.
  outcome String?
  /// Identifies the email or calendar event this came from, so syncing it twice logs it once.
  externalId String? @map("external_id")
  /// The record scope this row belongs to: a copy of its record's.
  scope String?

  @@unique([objectKey, recordId, externalId])
  @@index([objectKey, recordId])
  @@index([createdAt])
  @@index([scope])
  @@fullTextIndex([[summary], body], name: "activities_search")
  @@map("activities")
  @@rls
}

