/// One record's way through an email sequence (a campaign in crm.config.json):
/// which email is next and when it is due. See src/server/campaigns.ts.
model SequenceRun {
  id String @id @onCreate(uuid())
  createdAt DateTime @default(now()) @onCreate(now()) @map("created_at")
  updatedAt temporal.UpdatedAt @map("updated_at")
  campaignKey String @map("campaign_key")
  objectKey String @map("object_key")
  recordId String @map("record_id")
  /// "active", "finished" or "stopped".
  status String
  /// The id of the step to send next; null once the run is over.
  nextStep String? @map("next_step")
  /// When that step is due. While a step is being sent this is pushed a few
  /// minutes ahead, so a second sender leaves the run alone.
  dueAt DateTime? @map("due_at")
  /// How many times in a row sending the next step has failed.
  attempts Int @default(0)
  /// What happened last: why the run stopped, or the error from a failed send.
  note String?
  enrolledBy String? @map("enrolled_by")

  @@unique([campaignKey, objectKey, recordId])
  @@index([status, dueAt])
  @@map("sequence_runs")
  @@rls
}

