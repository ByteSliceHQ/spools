  recordId String @map("record_id")
  driveId String @map("drive_id")
  folderId String @map("folder_id")
  /// Where the folder was created, from the drive's top level. It may have been moved since.
  path String

  @@unique([objectKey, recordId])
  @@index([folderId])
  @@map("record_folders")
  @@rls
}

