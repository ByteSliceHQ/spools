{
  "name": "@spools/starter",
  "version": "0.0.1",
  "private": true,
  "description": "A working Spool: what create-spools copies, and where the framework is developed",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "init": "spools init",
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build && spools check-client",
    "start": "NODE_ENV=production BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun server.prod.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "crm:gen": "spools gen",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:push": "bun --bun x prisma db update && spools harden",
    "db:reset": "supabase db reset && bun --bun x prisma db init && spools harden && bun run db:seed",
    "db:seed": "bun scripts/seed.ts",
    "db:plan": "bun --bun x prisma migration plan",
    "db:migrate": "bun --bun x prisma db migrate && spools harden",
    "db:studio": "open http://127.0.0.1:54323",
    "db:harden": "spools harden",
    "db:stats": "spools stats",
    "swirls:check": "swirls doctor",
    "dev:e2e": "CRM_GUIDES=${CRM_GUIDES:-off} bunx --bun vite dev --config vite.config.e2e.ts",
    "demo": "bunx --bun vite build --config vite.config.e2e.ts && CRM_GUIDES=${CRM_GUIDES:-off} HOST=${HOST:-localhost} PORT=${PORT:-3100} BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun server.prod.ts"
  },
  "dependencies": {
    "@cipherstash/stack": "1.2.1",
    "@clerk/tanstack-react-start": "^1.7.11",
    "@effect/sql-pg": "4.1.5",
    "@effect/sql-pglite": "4.1.5",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "@swirls/sdk": "^2.3.0",
    "@swirls/spools": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "better-auth": "1.7.27",
    "effect": "4.1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "nitro": "3.0.260903-beta",
    "prisma": "8.0.0-rc.33",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
