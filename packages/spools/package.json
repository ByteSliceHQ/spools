{
  "name": "@swirls/spools",
  "version": "0.2.0",
  "description": "Open source CRM framework for coding agents: sign-in, data, security, search, email and tests built in",
  "keywords": [
    "agents",
    "crm",
    "effect",
    "framework",
    "swirls",
    "tanstack-start"
  ],
  "homepage": "https://spools.codes",
  "bugs": {
    "url": "https://github.com/ByteSliceHQ/spools/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByteSliceHQ/spools.git",
    "directory": "packages/spools"
  },
  "bin": {
    "spools": "./src/cli/main.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/crm/ui/theme.css",
    "./src/cli/*.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./extensions": "./src/extensions.ts",
    "./handlers": "./src/server/handlers.ts",
    "./adapter": "./src/adapter.ts",
    "./server": "./src/server/entry.ts",
    "./server/runtime": "./src/server/runtime/index.ts",
    "./server/*": "./src/server/*.ts",
    "./start": "./src/server/middleware.ts",
    "./vite": "./src/vite.ts",
    "./guides": "./src/crm/guides.ts",
    "./testing": "./src/testing/index.ts",
    "./config-schema": "./src/crm/config-schema.ts",
    "./oxlint": "./src/oxlint/index.ts",
    "./pages/*": "./src/pages/*.tsx",
    "./api/*": "./src/api/*.ts",
    "./ui/brand": "./src/crm/ui/brand.ts",
    "./ui/*": "./src/crm/ui/*.tsx",
    "./theme.css": "./src/crm/ui/theme.css",
    "./auth/*/ui": "./src/adapters/auth/*/client.tsx",
    "./auth/*": "./src/adapters/auth/*/server.ts",
    "./database/*": "./src/adapters/database/*/server.ts",
    "./files/*": "./src/adapters/files/*/server.ts",
    "./email/*": "./src/adapters/email/*/server.ts",
    "./vault/*": "./src/adapters/vault/*/server.ts",
    "./agents/*": "./src/adapters/agents/*/server.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "build": "bun scripts/assemble.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration"
  },
  "dependencies": {
    "@ai-sdk/react": "^3",
    "@swirls/sdk": "^2.2.0",
    "ai": "^6",
    "lucide-react": "^1.72.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@cipherstash/stack": "1.2.1",
    "@clerk/tanstack-react-start": "^1.7.11",
    "@effect/sql-pg": "^4.1.5",
    "@effect/sql-pglite": "^4.1.5",
    "@electric-sql/pglite": "^0.5.16",
    "@oxlint/plugins": ">=1.90.0",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "better-auth": "^1.7.27",
    "effect": "^4.1.5",
    "nitro": "^3.0.260903-beta",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.38.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@cipherstash/stack": {
      "optional": true
    },
    "@clerk/tanstack-react-start": {
      "optional": true
    },
    "@effect/sql-pg": {
      "optional": true
    },
    "@effect/sql-pglite": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    },
    "@prisma/orm-postgres": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "resend": {
      "optional": true
    },
    "@oxlint/plugins": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4"
  }
}
